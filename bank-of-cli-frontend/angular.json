{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "bank-of-cli-frontend": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{ "glob": "**/*", "input": "src/assets", "output": "assets" }]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "fileReplacements": [{ "replace": "src/environments/environment.ts", "with": "src/environments/environment.prod.ts" }],
              "optimization": { "scripts": true, "styles": true, "fonts": false },
              "budgets": [{ "type": "initial", "maximumWarning": "500kB", "maximumError": "1MB" }]
            },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": { "proxyConfig": "proxy.conf.json" },
          "configurations": {
            "development": { "buildTarget": "bank-of-cli-frontend:build:development" },
            "production": { "buildTarget": "bank-of-cli-frontend:build:production" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
